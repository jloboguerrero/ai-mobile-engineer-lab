import 'dart:async';

import 'package:flutter_modular/flutter_modular.dart';

import 'data/data.dart';
import 'domain/domain.dart';
import 'presentation/presentation.dart';

final class {{Feature}}Module extends Module {
  static const routeName = '/{{feature}}/';

  @override
  void binds(Injector i) {
    // Repositories
    i.addLazySingleton<{{Feature}}RepositoryImpl>(
      () => {{Feature}}RepositoryImpl(
        i{{Feature}}Datasource: {{Feature}}DatasourceImpl(),
      ),
    );

    // Usecases
    i.addSingleton<Get{{Feature}}Usecase>(
      () => Get{{Feature}}Usecase(
        i{{Feature}}Repository: i<{{Feature}}RepositoryImpl>(),
      ),
    );

    // Blocs
    i.add(
      {{Feature}}Bloc.new,
      config: BindConfig<{{Feature}}Bloc>(
        onDispose: (bloc) => unawaited(bloc.close()),
      ),
    );
  }

  @override
  void routes(RouteManager r) {
    r.child(
      Modular.initialRoute,
      child: (_) => const {{Feature}}Screen(),
    );
  }
}
