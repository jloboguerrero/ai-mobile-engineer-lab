// presentation/screens/{{slug}}-screen.tsx — told whose data it shows; never asks the session.
import { useTranslation } from 'react-i18next';

import { PageError, PageLoading } from '@/ui/page-note';
import { Screen } from '@/ui/screen';
import { Text } from '@/ui/text';

import { use{{Entity}} } from '../queries/queries';

export type {{Feature}}ScreenProps = {
  id: string;
};

export function {{Feature}}Screen({ id }: {{Feature}}ScreenProps) {
  const { t } = useTranslation('{{feature}}');
  const query = use{{Entity}}(id);

  if (query.isPending) return <PageLoading />;
  if (query.error) return <PageError text={t('loadError')} retrying={query.isFetching} onRetry={() => void query.refetch()} />;

  return (
    <Screen>
      <Text variant="h3">{t('title')}</Text>
      <Text>{query.data.name}</Text>
    </Screen>
  );
}
