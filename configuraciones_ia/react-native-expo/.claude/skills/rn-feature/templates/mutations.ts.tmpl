// presentation/queries/mutations.ts — writes are never resent; the function decides what a lost answer means.
import { useMutation } from '@tanstack/react-query';

import { save{{Entity}} } from '../../data/fetchers';
import type { {{Entity}} } from '../../domain/types';

import { invalidate{{Feature}} } from './queries';

export function useSave{{Entity}}() {
  return useMutation({
    mutationFn: (value: {{Entity}}) => save{{Entity}}(value),
    mutationKey: ['{{slug}}', 'save'],
    // Cache work here runs even after the screen is gone.
    onSuccess: () => invalidate{{Feature}}(),
  });
}
