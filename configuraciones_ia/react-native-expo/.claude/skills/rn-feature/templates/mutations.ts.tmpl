import { useMutation, useQueryClient } from '@tanstack/react-query';

import { useCurrentEmployeeId } from '@/features/session';

import { {{feature}}Api } from '../di';
import { {{feature}}Keys } from './keys';

import type { {{Entity}}Request } from '../forms/toRequest';

// Writes are never retried (queryClient default retry:false for mutations).
export const useSave{{Entity}} = () => {
  const queryClient = useQueryClient();
  const employeeId = useCurrentEmployeeId();
  return useMutation({
    mutationFn: (body: {{Entity}}Request) => {{feature}}Api.save{{Entity}}(employeeId, body),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: {{feature}}Keys.scope(employeeId) }),
  });
};
