import { render, screen } from '@testing-library/react-native';

import { stubNetwork } from '@/core/network.fixture';
import { WithQueryClient } from '@/core/query.fixture';

import { {{Feature}}Screen } from './{{slug}}-screen';

describe('{{Feature}}Screen', () => {
  it('shows the name once it loads', async () => {
    stubNetwork([{ data: { id: '1', name: 'Vacation' }, status: 200 }]);
    await render(
      <WithQueryClient>
        <{{Feature}}Screen id="1" />
      </WithQueryClient>,
    );
    expect(await screen.findByText('Vacation')).toBeOnTheScreen();
  });
});
