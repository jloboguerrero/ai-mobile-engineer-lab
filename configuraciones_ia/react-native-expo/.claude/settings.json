{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npx tsc:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx jest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx expo lint:*)",
      "Bash(npx expo install --check:*)",
      "Bash(npx expo config:*)",
      "Bash(npx expo-doctor:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run mock:*)",
      "Bash(node tools/mock-api/privacy-scan.mjs:*)",
      "Bash(maestro test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(npx expo install:*)",
      "Bash(npm install:*)",
      "Bash(eas:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.expo/**)",
      "Read(./ios/**)",
      "Read(./android/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(**/.env*)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.mobileprovision)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/credentials.json)",
      "Bash(eas submit:*)",
      "Bash(eas update --channel production:*)",
      "Bash(git push:*)"
    ]
  },
  "env": {
    "EXPO_NO_TELEMETRY": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format_and_lint.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check_pii_logging.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check_file_size.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.sh" }
        ]
      }
    ]
  }
}
